# ========================================
# Production Environment Configuration
# ========================================
# Copy this file to .env and update the values for production
# This file is used by Docker Compose and the application

# ========================================
# Database (embedded SQLite)
# ========================================
# The database is a single file on the app_data volume — docker-compose.yml
# already sets DATABASE_URL=file:/app/data/app.db, so nothing is needed here.
# Because the file is local to the container, run exactly one app instance.

# ========================================
# Application Configuration
# ========================================
APP_PORT=3001
APP_URL=http://localhost:3001
NODE_ENV=production
TZ=Europe/Rome

# ========================================
# White-Label Branding (optional)
# ========================================
# Overrides branding.config.ts at runtime — no rebuild needed.
# Full reference: docs/WHITE_LABEL.md
# BRAND_APP_NAME=Presenze Acme
# BRAND_APP_SHORT_NAME=Presenze
# BRAND_COMPANY_NAME=Acme S.p.A.
# BRAND_PRIMARY_COLOR=#2563eb
# BRAND_LOGO_LIGHT=/branding/acme-logo-light.svg
# BRAND_LOGO_DARK=/branding/acme-logo-dark.svg

# ========================================
# NextAuth Configuration
# ========================================
# IMPORTANT: Generate a secure secret with:
# openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_STRING
NEXTAUTH_URL=http://localhost:3001

# ========================================
# Email Configuration (Optional)
# ========================================
# Required for password reset functionality
EMAIL_HOST=smtp.gmail.com
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=Time Tracker

# ========================================
# Backup Configuration
# ========================================
# Cron schedule for automatic backups (default: 2:00 AM daily)
BACKUP_CRON_SCHEDULE="0 2 * * *"
# Email recipient for backup notifications (optional, defaults to EMAIL_USER)
BACKUP_EMAIL_RECIPIENT=

# S3 Upload (Hetzner Object Storage)
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=eu-central
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_PREFIX=backups/database
# BACKUP_S3_ENDPOINT=https://fsn1.your-objectstorage.com

# ========================================
# Docker Image Configuration
# ========================================
# Use specific version in production:
# DOCKER_IMAGE=ghcr.io/matte1240/app-presenze:1.0.0
# Or use latest:
# DOCKER_IMAGE=ghcr.io/matte1240/app-presenze:latest
DOCKER_IMAGE=ghcr.io/matte1240/app-presenze:latest
