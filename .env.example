# Copy to .env and adjust. Every value below is optional: the application
# starts with these defaults and walks you through creating the first
# administrator on first visit.

# ── Basics ────────────────────────────────────────────────────────────────
TZ=Europe/Rome
APP_PORT=3000
# Used in the links inside outgoing email, so it must be reachable by staff.
APP_URL=http://localhost:3000
APP_NAME=Presenze
COMPANY_NAME=

# Local patron saint holidays, as MM-DD, comma separated. The eleven national
# Italian holidays are built in and need no configuration.
HOLIDAY_PATRON_DAYS=

# ── Email (optional) ──────────────────────────────────────────────────────
# Without these the application runs fine but sends nothing: password reset
# links, leave notifications and timesheet reminders are all skipped and
# logged instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=presenze@example.com

# ── Scheduled jobs ────────────────────────────────────────────────────────
ENABLE_CRON=true
BACKUP_CRON=0 2 * * *
REMINDER_CRON=0 19 * * *
# Backups are pruned by age, but never below BACKUP_MIN_COUNT copies — a
# machine that was switched off for a month should not wake up and delete
# everything it has.
BACKUP_RETENTION_DAYS=30
BACKUP_MIN_COUNT=7
BACKUP_EMAIL_TO=

# ── Storage (leave alone under Docker) ────────────────────────────────────
# DATABASE_FILE=./data/app.db
# BACKUP_DIR=./backups
