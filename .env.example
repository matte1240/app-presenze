# Copy to .env and adjust. Only the database settings are required; everything
# else has a working default, and the application walks you through creating
# the first administrator on first visit.

# ── Basics ────────────────────────────────────────────────────────────────
TZ=Europe/Rome
APP_PORT=3000
# Used in the links inside outgoing email, so it must be reachable by staff.
APP_URL=http://localhost:3000
APP_NAME=Presenze

# Defaults for newly created organizations; each keeps its own copy from then
# on and edits it in the application. Local patron saint holidays as MM-DD,
# comma separated — the eleven national Italian holidays are built in.
DEFAULT_HOLIDAY_PATRON_DAYS=

# ── Database (required) ───────────────────────────────────────────────────
# Two roles, two URLs, and the difference matters.
#
# DATABASE_URL is the role the application signs in with. It owns nothing, so
# PostgreSQL applies the row-level security policies to it: whatever a query
# asks for, it can only be shown rows belonging to the organization the request
# established. This is what keeps one customer out of another's data even if a
# filter is ever forgotten in the code.
#
# DATABASE_ADMIN_URL is the role that owns the tables, which PostgreSQL exempts
# from those policies. It runs the migrations and the three things that have to
# cross companies: resolving an email at sign-in, the back-office, and the
# nightly sweep. In production it is REQUIRED — without it the application runs
# as the owner and the policies protect nothing, so it refuses to start.
#
# Under Docker, compose builds both from POSTGRES_PASSWORD and
# POSTGRES_APP_PASSWORD.
POSTGRES_DB=presenze
POSTGRES_USER=presenze
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
# DATABASE_URL=postgres://presenze_app:...@localhost:5432/presenze
# DATABASE_ADMIN_URL=postgres://presenze:...@localhost:5432/presenze
# DATABASE_POOL_MAX=10

# ── Organizations ─────────────────────────────────────────────────────────
# Whether anyone may create an organization from the public page, or only you
# from the back-office.
SIGNUP_ENABLED=true
TRIAL_DAYS=14

# Creates the first back-office administrator at boot, and only while there is
# none. Both are needed; either alone is ignored.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# ── Pagamenti (optional in sviluppo) ──────────────────────────────────────
# Senza queste chiavi l'applicazione parte lo stesso e la pagina Abbonamento
# dice che i pagamenti non sono configurati: nessuno ha bisogno di un account
# Stripe per lavorare sul cartellino.
#
# Il webhook va puntato su  <APP_URL>/api/webhooks/stripe  e deve iscriversi a
# checkout.session.completed, customer.subscription.created/updated/deleted e
# invoice.payment_failed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Un prezzo ricorrente per piano. Un piano senza prezzo resta assegnabile dal
# back-office ma non acquistabile.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ── Email (optional) ──────────────────────────────────────────────────────
# Without these the application runs fine but sends nothing: password reset
# links, leave notifications and timesheet reminders are all skipped and
# logged instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=presenze@example.com

# ── Scheduled jobs ────────────────────────────────────────────────────────
# Jobs take a Postgres advisory lock before running, so leaving this on across
# several replicas still means exactly one run.
ENABLE_CRON=true
REMINDER_CRON=0 19 * * *

# ── Backups (optional in development) ─────────────────────────────────────
# Whole-database backups, managed from the back office, stored on any
# S3-compatible bucket — Hetzner Object Storage is what these defaults assume.
# Without all four S3 variables the backup screen says so instead of the
# application refusing to start; an organization's own "Manutenzione" screen
# always works regardless, since it only exports that one company's data.
#
# Hetzner: create the bucket in the Object Storage console, then take the
# endpoint it shows you (e.g. https://fsn1.your-objectstorage.com) and a pair
# of access keys from the same screen.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style addressing (endpoint/bucket/key). Hetzner's endpoint has no
# wildcard certificate for <bucket>.<endpoint>, so virtual-hosted style fails
# TLS verification — leave this on unless the provider is AWS itself.
S3_FORCE_PATH_STYLE=true
BACKUP_PREFIX=backups/
BACKUP_CRON=0 3 * * *
# Backups older than this are pruned — but never below BACKUP_MIN_COUNT, so an
# installation left quiet for a month doesn't wake up and delete everything.
BACKUP_RETENTION_DAYS=30
BACKUP_MIN_COUNT=7
BACKUP_EMAIL_TO=
