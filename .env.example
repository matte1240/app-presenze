# ========================================
# 🌍 ENVIRONMENT CONFIGURATION
# ========================================
# This file contains all environment variables for the Presenze.
# Copy this file to `.env` and fill in your actual values.
# 
# Required variables are marked with [REQUIRED]
# Optional variables are marked with [OPTIONAL]
#

# ========================================
# 🚀 Application Settings
# ========================================

# [REQUIRED] Node environment (development, production, test)
NODE_ENV=development

# [OPTIONAL] Timezone for the application and scheduled jobs (default: Europe/Rome)
# Examples: Europe/Rome, Europe/London, America/New_York
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Rome

# [OPTIONAL] Application port (default: 3000)
APP_PORT=3000

# [OPTIONAL] Public URL of the application (used for absolute URLs in emails, etc.)
APP_URL=http://localhost:3000

# ========================================
# 🎨 White-Label Branding (Optional)
# ========================================
# The product ships branded through `branding.config.ts`. Everything below
# overrides that file at RUNTIME, so one Docker image can serve several
# customers without a rebuild. Leave a variable unset to keep the configured
# value. See docs/WHITE_LABEL.md for the complete guide.

# --- Identity ---
# [OPTIONAL] Product name: page titles, email subjects, PWA name
# BRAND_APP_NAME=Presenze Acme
# [OPTIONAL] Home-screen label for the installed PWA (keep it short)
# BRAND_APP_SHORT_NAME=Presenze
# [OPTIONAL] Meta description / PWA description
# BRAND_APP_DESCRIPTION=Gestione presenze e orari dipendenti
# [OPTIONAL] Headline and paragraph on the login page
# BRAND_APP_TAGLINE=Gestione Presenze e Orari
# BRAND_APP_SUBTITLE=Traccia le tue attività giornaliere e mantieni il team sincronizzato.
# [OPTIONAL] Locale used for formatting, and the <html lang> attribute
# BRAND_LOCALE=it-IT
# BRAND_HTML_LANG=it

# --- Company ---
# [OPTIONAL] Name in the login footer and email signature
# BRAND_COMPANY_NAME=Acme S.p.A.
# [OPTIONAL] Website linked from the footer. Use "none" to remove the link.
# BRAND_COMPANY_WEBSITE=https://acme.example
# [OPTIONAL] Support address shown to users. Use "none" to hide it.
# BRAND_SUPPORT_EMAIL=support@acme.example

# --- Logo ---
# Assets must live under /public (the app's CSP blocks external image hosts).
# Leave BRAND_LOGO_LIGHT unset to render a text wordmark built from the app name.
# BRAND_LOGO_LIGHT=/branding/acme-logo-light.svg
# BRAND_LOGO_DARK=/branding/acme-logo-dark.svg
# [OPTIONAL] Square mark, also used as the source for `npm run brand:icons`
# BRAND_LOGO_ICON=/branding/acme-mark.svg
# [OPTIONAL] Alt text and intrinsic aspect ratio of the wordmark
# BRAND_LOGO_ALT=Acme
# BRAND_LOGO_WIDTH=257
# BRAND_LOGO_HEIGHT=52
# [OPTIONAL] Logos embedded in emails — filenames relative to /public
# BRAND_EMAIL_LOGO_LIGHT=branding/email-logo.png
# BRAND_EMAIL_LOGO_DARK=branding/email-logo-white.png
# BRAND_EMAIL_LOGO_WIDTH=180

# --- Icons / favicons ---
# Generate a matching set with: npm run brand:icons -- --source <your-logo>
# BRAND_FAVICON=/branding/favicon.png
# BRAND_FAVICON_DARK=/branding/favicon-dark.png
# BRAND_APPLE_TOUCH_ICON=/branding/apple-touch-icon.png
# [OPTIONAL] JSON arrays of PWA icons, if you deviate from the default filenames
# BRAND_PWA_ICONS=[{"src":"/branding/acme-192.png","sizes":"192x192","type":"image/png"}]
# BRAND_PWA_ICONS_DARK=[{"src":"/branding/acme-192-dark.png","sizes":"192x192","type":"image/png"}]

# --- Theme ---
# Easiest path: one brand color. The matching foreground and focus ring are
# derived automatically for readable contrast.
# BRAND_PRIMARY_COLOR=#2563eb
# [OPTIONAL] Separate primary for dark mode (defaults to BRAND_PRIMARY_COLOR)
# BRAND_PRIMARY_COLOR_DARK=#3b82f6
# [OPTIONAL] Global corner radius
# BRAND_RADIUS=0.75rem
# [OPTIONAL] Full palette override as JSON. Values are raw HSL triplets.
# Any token omitted here keeps its configured value.
# BRAND_THEME_LIGHT={"background":"210 40% 98%","primary":"221.2 83.2% 53.3%"}
# BRAND_THEME_DARK={"background":"222.2 84% 4.9%","primary":"217.2 91.2% 59.8%"}

# --- PWA / browser chrome ---
# BRAND_PWA_THEME_COLOR_LIGHT=#f8fafc
# BRAND_PWA_THEME_COLOR_DARK=#0f172a
# BRAND_PWA_BACKGROUND_COLOR=#f8fafc

# --- Email palette (inline colors, hex only) ---
# BRAND_EMAIL_COLOR_PRIMARY=#059669
# BRAND_EMAIL_COLOR_SUCCESS=#059669
# BRAND_EMAIL_COLOR_WARNING=#d97706
# BRAND_EMAIL_COLOR_DANGER=#dc2626
# BRAND_EMAIL_COLOR_INFO=#3b82f6

# --- Regional (build-time) ---
# The public-holiday calendar renders on both the server and the browser, so it
# must resolve identically in both. Set it in `branding.config.ts`, or use this
# NEXT_PUBLIC_ variable, which is inlined at build time.
# ISO country code: IT, FR, DE, ES, ...
# NEXT_PUBLIC_BRAND_HOLIDAY_COUNTRY=IT

# ========================================
# 🗄️ Database Configuration
# ========================================

# [REQUIRED] SQLite database file
# Format: file:<path>  — relative paths resolve from the project root.
#
# For local development the file lives in ./data (git-ignored).
# In Docker use an absolute path on the app_data volume:
#   DATABASE_URL=file:/app/data/app.db
DATABASE_URL=file:./data/app.db

# NOTE: the database is an in-process file, so exactly one instance of the app
# may run against it. Do not scale the `app` service horizontally.

# ========================================
# 🔐 Authentication (NextAuth)
# ========================================

# [REQUIRED] Secret key for session encryption
# Generate with: openssl rand -base64 32
# IMPORTANT: Use a strong, random value in production!
NEXTAUTH_SECRET=your_nextauth_secret_here_CHANGE_THIS

# [REQUIRED] Application URL for NextAuth callbacks
# Must match the actual URL where your app is accessible
# In production, use HTTPS: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# ========================================
# 📧 Email Configuration (Optional but Recommended)
# ========================================
# Email is used for:
# - Welcome emails with temporary passwords
# - Password reset links
# - Leave request notifications
# - Backup status alerts
#
# If not configured, email features will be disabled.

# [OPTIONAL] SMTP server hostname (e.g., smtp.gmail.com for Gmail)
EMAIL_HOST=smtp.gmail.com

# [OPTIONAL] SMTP server port (587 for TLS, 465 for SSL)
EMAIL_PORT=587

# [OPTIONAL] SMTP username (usually your email address)
EMAIL_USER=your_email@gmail.com

# [OPTIONAL] SMTP password or app-specific password
# For Gmail: Generate at https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your_app_password_here

# [OPTIONAL] "From" email address shown in sent emails
EMAIL_FROM=noreply@yourcompany.com

# [OPTIONAL] "From" name shown in sent emails
EMAIL_FROM_NAME=Presenze

# ========================================
# 🗓️ Google Calendar Integration (Optional)
# ========================================
# Automatically sync approved leave requests to Google Calendar.
# Requires a Google Cloud service account.
#
# Setup:
# 1. Create a service account in Google Cloud Console
# 2. Enable Google Calendar API
# 3. Generate a JSON key file
# 4. Share your calendar with the service account email
#
# If not configured, leave requests will work without calendar sync.

# [OPTIONAL] Service account email from JSON key file
GOOGLE_CLIENT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com

# [OPTIONAL] Private key from JSON key file
# IMPORTANT: Keep the \n line breaks in the key!
# Format: -----BEGIN PRIVATE KEY-----\nYourKeyHere\n-----END PRIVATE KEY-----\n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"

# [OPTIONAL] Google Calendar ID to sync events to
# Find in: Google Calendar Settings > Integrate calendar
# Format: calendar-id@group.calendar.google.com or primary
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# ========================================
# 💾 Automated Backup System (Optional)
# ========================================

# [OPTIONAL] Cron schedule for automated database backups
# Format: "minute hour day month day-of-week"
# Examples:
#   "0 2 * * *"     - Daily at 2:00 AM
#   "0 */6 * * *"   - Every 6 hours
#   "0 2 * * 0"     - Weekly on Sunday at 2:00 AM
#   "0 2 1 * *"     - Monthly on the 1st at 2:00 AM
BACKUP_CRON_SCHEDULE="0 2 * * *"

# [OPTIONAL] Email recipient for backup notifications
# If not set, defaults to EMAIL_USER
BACKUP_EMAIL_RECIPIENT=admin@yourcompany.com

# [OPTIONAL] Backup retention days (default: 30)
BACKUP_RETENTION_DAYS=30

# [OPTIONAL] Minimum backups to keep (default: 7)
BACKUP_MIN_COUNT=7

# [OPTIONAL] Upload backups to S3-compatible storage (e.g., Hetzner Object Storage)
# If configured, backups are uploaded to S3 in addition to local storage.
BACKUP_S3_BUCKET=my-backup-bucket
BACKUP_S3_REGION=eu-central
BACKUP_S3_ACCESS_KEY_ID=your_access_key
BACKUP_S3_SECRET_ACCESS_KEY=your_secret_key
BACKUP_S3_PREFIX=backups/database
BACKUP_S3_ENDPOINT=https://nbg1.your-objectstorage.com

# ========================================
# 🐳 Docker Configuration (Optional)
# ========================================
# Used for CI/CD and container registry settings

# [OPTIONAL] Docker registry URL for pushing images
DOCKER_REGISTRY=ghcr.io

# [OPTIONAL] Docker registry username (GitHub username for GHCR)
DOCKER_USERNAME=your_username

# [OPTIONAL] Docker image tag (default: latest)
TAG=latest

# [OPTIONAL] Docker host binding (use 0.0.0.0 for external access)
HOSTNAME=0.0.0.0

# ========================================
# 📱 Progressive Web App (PWA) - No configuration needed
# ========================================
# PWA features are automatically enabled.
# Manifest and service worker are included in the build.
# For production, ensure NEXTAUTH_URL uses HTTPS.

# ========================================
# 🔧 Advanced Settings (Usually not needed)
# ========================================

# [OPTIONAL] Database connection pool size (default: 10)
# DATABASE_POOL_SIZE=10

# [OPTIONAL] Session inactivity timeout in seconds (default: 1800 = 30 minutes)
# SESSION_MAX_AGE=1800

# [OPTIONAL] Log level (error, warn, info, debug)
# LOG_LEVEL=info

# ========================================
# 📝 Notes
# ========================================
#
# - Never commit your actual `.env` file to version control!
# - Use strong, unique values for all secrets in production
# - Test email configuration before deploying
# - Backup your `.env` file securely
# - For production, use environment-specific values
#
# Need help? See docs/CONFIGURATION.md for detailed setup guides.
#

